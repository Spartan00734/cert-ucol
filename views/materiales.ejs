<!-- views/materiales.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Registro de Materiales</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="bg-light">
  <div class="container mt-4">
     <!-- 🚨 BLOQUE DE ALERT -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <!-- 🚨 FIN BLOQUE DE ALERT -->
    <h1 class="text-center text-success">Registro de Materiales</h1>

    <% const FD  = (typeof formData !== 'undefined' && formData) ? formData : {}; %>
    <% const ERR = (typeof errors   !== 'undefined' && errors)   ? errors   : [];  %>

    <% if (ERR.length) { %>
      <div class="alert alert-danger"><%= ERR[0].msg %></div>
    <% } %>

    <div class="card shadow p-4">
      <form id="materiales-form" onsubmit="return false;">
        <% if (typeof csrfToken !== 'undefined') { %>
          <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
        <% } %>

        <div class="row g-3 align-items-end">
          <div class="col-md-6">
            <label for="nombreMaterial" class="form-label">Material:</label>
            <input type="text" id="nombreMaterial" class="form-control" required>
          </div>

          <div class="col-md-3">
            <label for="cantidadMaterial" class="form-label">Cantidad (texto):</label>
            <input type="text" id="cantidadMaterial" class="form-control" required placeholder="Ej. 5 paquetes">
          </div>

          <div class="col-md-3 d-grid">
            <button type="button" id="btnAgregar" class="btn btn-success">Agregar a la lista</button>
          </div>
        </div>
      </form>
    </div>

    <h2 class="text-success mt-4">Lista por guardar</h2>
    <div class="table-responsive">
      <table class="table table-bordered table-striped mt-3 align-middle">
        <thead class="table-success">
          <tr>
            <th>#</th>
            <th>Material</th>
            <th>Cantidad (texto)</th>
            <th style="width: 140px;">Acciones</th>
          </tr>
        </thead>
        <tbody id="tablaTemporal">
          <!-- filas temporales -->
        </tbody>
      </table>
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-primary" id="btnGuardarTodo" disabled>Guardar todo</button>
      <button class="btn btn-outline-secondary" id="btnLimpiarLista" disabled>Limpiar lista</button>
    </div>

    <hr class="my-4"/>

    <h2 class="text-success">Materiales guardados</h2>
    <div class="table-responsive">
      <table class="table table-bordered table-striped mt-3 align-middle">
        <thead class="table-success">
          <tr>
            <th>#</th>
            <th>Material</th>
            <th>Cantidad</th>
          </tr>
        </thead>
        <tbody>
        <% if (Array.isArray(materiales) && materiales.length) { %>
          <% materiales.forEach((m, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= m.nombre %></td>
              <td>
                <%= (m.cantidad_texto && m.cantidad_texto.trim())
                      ? m.cantidad_texto
                      : (typeof m.cantidad === 'number' ? m.cantidad : '—') %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="3" class="text-center text-muted">No hay materiales guardados.</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>

    <a href="/ambulancia" class="btn btn-outline-secondary w-100 mt-2"> Siguiente </a>
    <a href="/" class="btn btn-secondary w-100 mt-2">⬅ Regresar</a>
  </div>

  <script>
    const $ = (s) => document.querySelector(s);
    const nombreInput = $('#nombreMaterial');
    const cantidadInput = $('#cantidadMaterial');
    const tablaTemporal = $('#tablaTemporal');
    const btnAgregar = $('#btnAgregar');
    const btnGuardarTodo = $('#btnGuardarTodo');
    const btnLimpiarLista = $('#btnLimpiarLista');
    const csrfTokenEl = document.getElementById('csrfToken');

    /** Estado temporal en memoria */
    let lista = [];

    function escapeHtml(str) {
      return String(str).replace(/[&<>"'`=\/]/g, s => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#x2F;','`':'&#x60;','=':'&#x3D;'
      }[s] || s));
    }

    function refrescarTabla() {
      tablaTemporal.innerHTML = '';
      if (!lista.length) {
        btnGuardarTodo.disabled = true;
        btnLimpiarLista.disabled = true;
        return;
      }
      btnGuardarTodo.disabled = false;
      btnLimpiarLista.disabled = false;

      lista.forEach((item, idx) => {
        const tr = document.createElement('tr');

        const tdIdx = document.createElement('td');
        tdIdx.textContent = idx + 1;

        const tdNombre = document.createElement('td');
        const inNombre = document.createElement('input');
        inNombre.type = 'text';
        inNombre.className = 'form-control';
        inNombre.value = item.nombreMaterial;
        inNombre.onchange = (e) => { lista[idx].nombreMaterial = e.target.value.trim(); };
        tdNombre.appendChild(inNombre);

        const tdCantidad = document.createElement('td');
        const inCantidad = document.createElement('input');
        inCantidad.type = 'text'; // ← TEXTO
        inCantidad.className = 'form-control';
        inCantidad.placeholder = 'Ej. 5 paquetes';
        inCantidad.value = item.cantidadMaterial || '';
        inCantidad.onchange = (e) => { lista[idx].cantidadMaterial = (e.target.value || '').trim(); };
        tdCantidad.appendChild(inCantidad);

        const tdAcciones = document.createElement('td');
        const btnEliminar = document.createElement('button');
        btnEliminar.className = 'btn btn-sm btn-danger me-2';
        btnEliminar.textContent = 'Eliminar';
        btnEliminar.onclick = () => { lista.splice(idx,1); refrescarTabla(); };

        tdAcciones.appendChild(btnEliminar);

        tr.append(tdIdx, tdNombre, tdCantidad, tdAcciones);
        tablaTemporal.appendChild(tr);
      });
    }

    btnAgregar.addEventListener('click', () => {
      const nombre = (nombreInput.value || '').trim();
      const cantidad = (cantidadInput.value || '').trim(); // ← TEXTO
      if (!nombre) {
        alert('Escribe el nombre del material.');
        return;
      }
      if (!cantidad) {
        alert('Escribe la cantidad (puede ser texto: "5 paquetes").');
        return;
      }
      lista.push({ nombreMaterial: nombre, cantidadMaterial: cantidad });
      nombreInput.value = '';
      cantidadInput.value = '';
      nombreInput.focus();
      refrescarTabla();
    });

    btnLimpiarLista.addEventListener('click', () => {
      if (!lista.length) return;
      if (confirm('¿Vaciar la lista temporal?')) {
        lista = [];
        refrescarTabla();
      }
    });

    btnGuardarTodo.addEventListener('click', async () => {
      if (!lista.length) return;
      try {
        const headers = { 'Content-Type': 'application/json' };
        if (csrfTokenEl) headers['CSRF-Token'] = csrfTokenEl.value;

        const res = await fetch('/guardar-materiales-batch', {
          method: 'POST',
          headers,
          body: JSON.stringify({ items: lista })
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.msg || 'Error al guardar');
        alert('Materiales guardados correctamente');
        // Limpia la lista y recarga para verlos en la tabla de abajo
        lista = [];
        refrescarTabla();
        window.location.reload();
      } catch (err) {
        console.error(err);
        alert('No se pudieron guardar los materiales.');
      }
    });

    // init
    refrescarTabla();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-cerrar alert en 3.5s
    setTimeout(() => {
      const el = document.querySelector('.alert.alert-dismissible');
      if (!el) return;
      try {
        const alert = bootstrap.Alert.getOrCreateInstance(el);
        alert.close();
      } catch (e) {
        el.classList.remove('show');
        el.addEventListener('transitionend', () => el.remove());
      }
    }, 3500);
  </script>
</body>
</html>
