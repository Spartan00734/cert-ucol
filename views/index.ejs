<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CERT UCOL • Panel principal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link href="/styles.css" rel="stylesheet">
</head>
<body class="dashboard-hero">
  <!-- Appbar -->
  <header class="appbar">
    <div class="inner">
      <div class="brand">
        <div class="logo">
          <img src="/img/logo.png" alt="Logo de CERT UCOL" style="width: 70px; height: auto;" />
        </div>
        <div>
          <div>CERT UCOL</div>
          <small>Panel principal</small>
        </div>
      </div>

      <div class="d-flex align-items-center gap-3">
        <% if (currentUser) { %>
          <% const roleLabel = currentUser.role === 'admin' ? 'Administrador' : 'Trabajador'; %>
          <div class="text-end d-none d-sm-block" style="color:#eaf4f0;font-size:0.9rem;">
            <div><strong><%= currentUser.nombre || currentUser.username %></strong></div>
            <small><%= roleLabel %></small>
          </div>
        <% } %>
        <form action="/logout" method="POST">
          <button class="btn-pill" type="submit">
            <i class="bi bi-box-arrow-right icon-white"></i>
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="shell">
    <!-- Flash message -->
    <% if (flash) { %>
      <div class="flash-message <%= flash.type %>">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- Panel central -->
    <section class="sheet" style="max-width: 960px;">
      <h2 class="sheet-title" style="margin-bottom: 4px;">Bienvenido</h2>

      <% if (currentUser) { %>
        <% const roleLabel = currentUser.role === 'admin' ? 'Administrador' : 'Trabajador'; %>
        <p class="text-center" style="color:#4a675d;margin-bottom:10px;">
          Sesión iniciada como:
          <strong><%= currentUser.nombre || currentUser.username %></strong>
          (<%= roleLabel %>)
        </p>
      <% } %>

      <p class="text-center" style="color:#4a675d;margin-bottom:18px;">
        Accede rápidamente a los módulos clave. 
      </p>

      <!-- Acciones primarias -->
      <div class="row g-3 mb-3">
        <div class="col-12">
          <p class="text-center" style="color:#4a675d;margin-bottom:18px;">
            Historial de PDFs
          </p>
          <a href="/snapshots" class="btn-pill d-block text-center" title="Historial de PDFs">
            <i class="bi bi-file-earmark-text icon-white"></i>
          </a>
        </div>
      </div>

      <!-- Accesos a módulos -->
      <div class="grid">
        <!-- Pacientes: ahora visible para TODOS los usuarios logueados -->
        <div class="card span-6">
          <h2>Pacientes</h2>
          <p>Registro y signos vitales del paciente.</p>
          <div class="actions">
            <a href="/paciente" class="btn primary full" title="Pacientes">
              <i class="bi bi-heart-pulse icon-white"></i>
            </a>
          </div>
        </div>

        <!-- Materiales -->
        <div class="card span-6">
          <h2>Materiales</h2>
          <p>Control de inventario y envíos en lote.</p>
          <div class="actions">
            <a href="/materiales" class="btn primary full" title="Materiales">
              <i class="bi bi-box-seam icon-white"></i>
            </a>
          </div>
        </div>

        <!-- Ambulancia -->
        <div class="card span-6">
          <h2>Ambulancia</h2>
          <p>Servicios, folios y traslados.</p>
          <div class="actions">
            <a href="/ambulancia" class="btn primary full" title="Ambulancia">
              <i class="bi bi-truck icon-white"></i>
            </a>
          </div>
        </div>

        <!-- Gestión de usuarios: solo ADMIN -->
        <% if (currentUser && currentUser.role === 'admin') { %>
          <div class="card span-6">
            <h2>Alta de usuarios</h2>
            <p>Crear cuentas de Administrador o Trabajador.</p>
            <div class="actions">
              <a href="/registro" class="btn primary full" title="Gestión de usuarios">
                <i class="bi bi-people icon-white"></i>
              </a>
            </div>
          </div>

          <!-- Nuevo: catálogos -->
          <div class="card span-6">
            <h2>Catálogos</h2>
            <p>Ambulancias, tipos de servicio y lesiones.</p>
            <div class="actions">
              <a href="/admin/catalogos" class="btn primary full" title="Catálogos">
                <i class="bi bi-list-check icon-white"></i>
              </a>
            </div>
          </div>

          <!-- Nuevo: usuarios -->
          <div class="card span-6">
            <h2>Usuarios</h2>
            <p>Consulta y eliminación de usuarios trabajadores.</p>
            <div class="actions">
              <a href="/admin/usuarios" class="btn primary full" title="Usuarios">
                <i class="bi bi-person-lines-fill icon-white"></i>
              </a>
            </div>
          </div>
        <% } %>

        <!-- Estado general (visible para todos los roles) -->
        <div class="card span-6 intro">
          <h2>Estado general</h2>
          <p>Pacientes, materiales y servicios en un solo lugar.</p>
          <div class="actions">
            <a href="/vista" class="btn ghost full" title="Estado General">
              <i class="bi bi-bar-chart-line icon-white"></i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // autocerrar flash-message
    setTimeout(() => {
      const msg = document.querySelector('.flash-message');
      if (msg) {
        msg.style.transition = "opacity 0.6s ease";
        msg.style.opacity = "0";
        setTimeout(() => msg.remove(), 600);
      }
    }, 3500);
  </script>
</body>
</html>
