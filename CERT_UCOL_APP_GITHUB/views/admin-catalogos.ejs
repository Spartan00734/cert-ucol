<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Administrar catálogos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="bg-light">

  <div class="container mt-4">

    <!-- 🚨 BLOQUE DE ALERT -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <!-- 🚨 FIN BLOQUE DE ALERT -->

    <h1 class="text-success mb-3 text-center">Administración de catálogos</h1>

    <p class="text-muted">
      Desde esta vista puedes administrar las ambulancias, tipos de servicio y el catálogo de lesiones.
      Solo los administradores tienen acceso a esta pantalla.
    </p>

    <!-- ===================== AMBULANCIAS ===================== -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-truck-front me-2"></i>Ambulancias</h5>
      </div>
      <div class="card-body">
        <!-- Agregar ambulancia -->
        <form class="row g-3 mb-3" action="/catalogo/ambulancias/agregar" method="POST">
          <% if (typeof csrfToken !== 'undefined') { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <div class="col-md-8">
            <label class="form-label">Nueva ambulancia</label>
            <input type="text" name="nombre" class="form-control" placeholder="Ej. Ambulancia CERT-03" required>
          </div>
          <div class="col-md-4 d-grid align-self-end">
            <button class="btn btn-success">
              <i class="bi bi-plus-circle me-1"></i>Agregar
            </button>
          </div>
        </form>

        <!-- Lista de ambulancias -->
        <div class="table-responsive">
          <table class="table table-sm table-bordered align-middle">
            <thead class="table-success">
              <tr>
                <th style="width:60px;">#</th>
                <th>Nombre</th>
                <th style="width:140px;" class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(ambulancias) && ambulancias.length) { %>
                <% ambulancias.forEach((a, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= a %></td>
                    <td class="text-center">
                      <form action="/catalogo/ambulancias/eliminar"
                            method="POST"
                            class="d-inline"
                            onsubmit="return confirm('🚨 Se eliminará la ambulancia &quot;<%= a %>&quot; del catálogo. ¿Deseas continuar?');">
                        <% if (typeof csrfToken !== 'undefined') { %>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <input type="hidden" name="nombre" value="<%= a %>">
                        <button class="btn btn-sm btn-outline-danger rounded-pill">
                          <i class="bi bi-trash me-1"></i>Quitar
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center text-muted">No hay ambulancias registradas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ===================== TIPOS DE SERVICIO ===================== -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-activity me-2"></i>Tipos de servicio</h5>
      </div>
      <div class="card-body">
        <!-- Agregar tipo de servicio -->
        <form class="row g-3 mb-3" action="/catalogo/tipos-servicio/agregar" method="POST">
          <% if (typeof csrfToken !== 'undefined') { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <div class="col-md-8">
            <label class="form-label">Nuevo tipo de servicio</label>
            <input type="text" name="nombre" class="form-control" placeholder="Ej. Cobertura preventiva" required>
          </div>
          <div class="col-md-4 d-grid align-self-end">
            <button class="btn btn-success">
              <i class="bi bi-plus-circle me-1"></i>Agregar
            </button>
          </div>
        </form>

        <!-- Lista de tipos de servicio -->
        <div class="table-responsive">
          <table class="table table-sm table-bordered align-middle">
            <thead class="table-success">
              <tr>
                <th style="width:60px;">#</th>
                <th>Tipo de servicio</th>
                <th style="width:140px;" class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(tiposServicio) && tiposServicio.length) { %>
                <% tiposServicio.forEach((t, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= t %></td>
                    <td class="text-center">
                      <form action="/catalogo/tipos-servicio/eliminar"
                            method="POST"
                            class="d-inline"
                            onsubmit="return confirm('🚨 Se eliminará el tipo de servicio &quot;<%= t %>&quot; del catálogo. ¿Deseas continuar?');">
                        <% if (typeof csrfToken !== 'undefined') { %>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <input type="hidden" name="nombre" value="<%= t %>">
                        <button class="btn btn-sm btn-outline-danger rounded-pill">
                          <i class="bi bi-trash me-1"></i>Quitar
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center text-muted">No hay tipos de servicio registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ===================== LESIONES ===================== -->
    <div class="card mb-5 shadow-sm">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-heart-pulse me-2"></i>Catálogo de lesiones</h5>
      </div>
      <div class="card-body">
        <p class="small text-muted">
          Puedes agregar nuevas lesiones por zona y eliminar las existentes.
        </p>

        <!-- Agregar lesión -->
        <form class="row g-3 mb-3" action="/catalogo/lesiones/agregar" method="POST">
          <% if (typeof csrfToken !== 'undefined') { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <div class="col-md-4">
            <label class="form-label">Zona</label>
            <select name="zona" class="form-select" required>
              <option value="" disabled selected>Selecciona zona…</option>
              <% (zonasLesion || []).forEach(z => { %>
                <option value="<%= z %>"><%= z %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label">Nombre de la lesión</label>
            <input type="text" name="nombre" class="form-control" placeholder="Describe la lesión…" required>
          </div>
          <div class="col-md-3 d-grid align-self-end">
            <button class="btn btn-success">
              <i class="bi bi-plus-circle me-1"></i>Agregar
            </button>
          </div>
        </form>

        <!-- Agrupar lesiones por zona -->
        <%
          const gruposLesiones = {};
          (lesionesLista || []).forEach(l => {
            const zona = l.zona || 'Sin zona';
            if (!gruposLesiones[zona]) gruposLesiones[zona] = [];
            gruposLesiones[zona].push(l);
          });
          const zonasCatalogo = Object.keys(gruposLesiones).sort();
        %>

        <% if (zonasCatalogo.length) { %>
          <div class="accordion" id="accLesionesAdmin">
            <% zonasCatalogo.forEach((zona, idxZona) => {
                 const grupo = gruposLesiones[zona];
                 const collapseId = 'lezZona' + idxZona;
                 const headingId  = 'headZona' + idxZona;
            %>
              <div class="accordion-item">
                <h2 class="accordion-header" id="<%= headingId %>">
                  <button class="accordion-button <%= idxZona ? 'collapsed' : '' %>" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#<%= collapseId %>"
                          aria-expanded="<%= idxZona ? 'false' : 'true' %>"
                          aria-controls="<%= collapseId %>">
                    <strong><%= zona %></strong>
                    <span class="badge bg-success ms-2"><%= grupo.length %></span>
                  </button>
                </h2>
                <div id="<%= collapseId %>"
                     class="accordion-collapse collapse <%= idxZona ? '' : 'show' %>"
                     aria-labelledby="<%= headingId %>"
                     data-bs-parent="#accLesionesAdmin">
                  <div class="accordion-body p-2">
                    <div class="table-responsive">
                      <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-success">
                          <tr>
                            <th style="width:60px;">#</th>
                            <th>Lesión</th>
                            <th style="width:140px;" class="text-center">Acciones</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% grupo.forEach((l, idxL) => { %>
                            <tr>
                              <td><%= idxL + 1 %></td>
                              <td><%= l.nombre %></td>
                              <td class="text-center">
                                <form action="/catalogo/lesiones/eliminar"
                                      method="POST"
                                      class="d-inline"
                                      onsubmit="return confirm('🚨 Se eliminará la lesión &quot;<%= l.nombre %>&quot; del catálogo. ¿Deseas continuar?');">
                                  <% if (typeof csrfToken !== 'undefined') { %>
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                  <% } %>
                                  <input type="hidden" name="id" value="<%= l._id %>">
                                  <button class="btn btn-sm btn-outline-danger rounded-pill">
                                    <i class="bi bi-trash me-1"></i>Quitar
                                  </button>
                                </form>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">No hay lesiones registradas en el catálogo.</p>
        <% } %>
      </div>
    </div>

    <a href="/" class="btn btn-secondary w-100 mb-4">⬅ Volver al menú</a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-cerrar alert en 3.5s
    setTimeout(function () {
      var el = document.querySelector('.alert.alert-dismissible');
      if (!el) return;
      try {
        var alert = bootstrap.Alert.getOrCreateInstance(el);
        alert.close();
      } catch (e) {
        el.classList.remove('show');
        el.addEventListener('transitionend', function () { el.remove(); });
      }
    }, 3500);
  </script>
</body>
</html>
