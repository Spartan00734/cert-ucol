<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Crear cuenta – CERT UCOL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link href="/styles.css" rel="stylesheet">
</head>
<body class="auth-hero">
  <!-- Hero con imagen -->
  <div class="hero-top">
    <div class="hero-img" style="background-image:url('/img/cert-hero.jpg');"></div>
    <div class="hero-title">
      <h1>CERT UCOL</h1>
      <small>Registro de usuarios</small>
    </div>
    <!-- Onda -->
    <svg class="hero-wave" viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg">
      <path fill="#b9d9cc" d="M0,64L48,85.3C96,107,192,149,288,149.3C384,149,480,107,576,96C672,85,768,107,864,122.7C960,139,1056,149,1152,138.7C1248,128,1344,96,1392,80L1440,64L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z"/>
    </svg>
  </div>

  <!-- Panel -->
  <main class="sheet">
    <h2 class="sheet-title">Crear Cuenta</h2>
    <p class="text-center" style="color:#4a675d; margin-top:-6px;">
      Solo los <strong>Administradores</strong> pueden crear nuevas cuentas.
    </p>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show mt-2" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <form action="/registro" method="post" class="mt-3">
      <div class="mb-3">
        <label class="form-label" for="nombre">Nombre completo</label>
        <input class="pill" id="nombre" name="nombre" type="text"
               placeholder="Tu nombre completo" required autocomplete="name">
      </div>

      <div class="mb-3">
        <label class="form-label" for="correo">Correo</label>
        <input class="pill" id="correo" name="correo" type="email"
               placeholder="tucorreo@ejemplo.com" required autocomplete="email">
      </div>

      <div class="mb-3">
        <label class="form-label" for="username">Usuario</label>
        <input class="pill" id="username" name="username" type="text"
               placeholder="Ej. a.garcia" required autocomplete="username">
      </div>

      <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <input class="pill" id="password" name="password" type="password"
               placeholder="••••••••" required autocomplete="new-password">
      </div>

      <div class="mb-3">
        <label class="form-label" for="role">Tipo de cuenta</label>
        <select id="role" name="role" class="pill form-select">
          <option value="admin">Administrador (puede registrar, modificar y borrar)</option>
          <option value="viewer">Trabajador (solo lectura y descarga de registros)</option>
        </select>
      </div>

      <button class="btn-pill" type="submit">Crear usuario</button>
    </form>

    <div class="inline-actions">
      <a href="/">⬅ Volver al panel principal</a>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
