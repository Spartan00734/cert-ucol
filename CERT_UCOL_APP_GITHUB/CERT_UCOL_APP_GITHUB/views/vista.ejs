<!-- views/vista.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Estado general</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="bg-light">
  <div class="container my-4">

    <!-- ALERTAS -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% const isAdmin = currentUser && currentUser.role === 'admin'; %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="text-success mb-0">Estado general</h2>

      <!-- Barra de acciones -->
      <div class="btn-toolbar gap-2 justify-content-end">

        <!-- Guardar / Descargar / Historial (admins y trabajadores) -->
        <div class="btn-group">
          <form action="/guardar-vista" method="POST" class="d-inline">
            <% if (typeof csrfToken !== 'undefined') { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <button type="submit" class="btn btn-outline-success btn-sm">
              <i class="bi bi-file-earmark-plus"></i> Guardar PDF
            </button>
          </form>

          <a href="/descargar-pdf" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-download"></i> Descargar PDF
          </a>

          <a href="/snapshots" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clock-history"></i> Historial
          </a>
        </div>

        <!-- Solo admin: limpiar todo -->
        <% if (isAdmin) { %>
          <form action="/limpiar" method="POST"
                class="d-inline ms-2"
                onsubmit="return confirm('⚠️ Esto eliminará TODOS los pacientes, materiales y servicios.\n\n¿Seguro que deseas continuar?');">
            <% if (typeof csrfToken !== 'undefined') { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <button type="submit" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-trash3"></i> Limpiar registros
            </button>
          </form>
        <% } else { %>
          <span class="badge bg-secondary ms-2">Modo trabajador</span>
        <% } %>
      </div>
    </div>

    <!-- PACIENTES -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-hearts me-1"></i> Pacientes</span>
        <span class="badge bg-light text-success"><%= (pacientes || []).length %></span>
      </div>
      <div class="card-body p-2">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Edad</th>
                <th>Género</th>
                <th>Lesión</th>
                <th>Glasgow</th>
                <% if (isAdmin) { %><th class="text-center">Acciones</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(pacientes) && pacientes.length) { %>
                <% pacientes.forEach((p, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= p.nombre %></td>
                    <td><%= p.edad %></td>
                    <td><%= p.genero %></td>
                    <td><%= p.lesion || '—' %></td>
                    <td><%= p.glasgow || '—' %></td>
                    <% if (isAdmin) { %>
                      <td class="text-center">
                        <form action="/pacientes/<%= p._id %>/eliminar" method="POST"
                              class="d-inline"
                              onsubmit="return confirm('¿Eliminar este paciente? Esta acción no se puede deshacer.');">
                          <% if (typeof csrfToken !== 'undefined') { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <button class="btn btn-sm btn-outline-danger rounded-pill">
                            <i class="bi bi-trash"></i> Eliminar
                          </button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= isAdmin ? 7 : 6 %>" class="text-center text-muted">
                    No hay pacientes registrados.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- MATERIALES -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-box-seam me-1"></i> Materiales</span>
        <span class="badge bg-light text-success"><%= (materiales || []).length %></span>
      </div>
      <div class="card-body p-2">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th>#</th>
                <th>Material</th>
                <th>Cantidad</th>
                <% if (isAdmin) { %><th class="text-center">Acciones</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(materiales) && materiales.length) { %>
                <% materiales.forEach((m, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= m.nombre %></td>
                    <td>
                      <%= (m.cantidad_texto && m.cantidad_texto.trim())
                            ? m.cantidad_texto
                            : (typeof m.cantidad === 'number' ? m.cantidad : '—') %>
                    </td>
                    <% if (isAdmin) { %>
                      <td class="text-center">
                        <form action="/materiales/<%= m._id %>/eliminar" method="POST"
                              class="d-inline"
                              onsubmit="return confirm('¿Eliminar este material?');">
                          <% if (typeof csrfToken !== 'undefined') { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <button class="btn btn-sm btn-outline-danger rounded-pill">
                            <i class="bi bi-trash"></i> Eliminar
                          </button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= isAdmin ? 4 : 3 %>" class="text-center text-muted">
                    No hay materiales registrados.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 🔢 RECUENTO DETALLADO DE MATERIALES POR MES (SOLO ADMIN) -->
    <% if (isAdmin) { %>
      <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <span><i class="bi bi-graph-up me-1"></i> Recuento de materiales por mes</span>
          <span class="badge bg-light text-success"><%= (resumenMaterialesMes || []).length %></span>
        </div>
        <div class="card-body p-3">
          <% if (Array.isArray(resumenMaterialesMes) && resumenMaterialesMes.length) { %>
            <p class="small text-muted mb-3">
              Se muestra el resumen de materiales usados, agrupados por mes y por tipo de material.
            </p>

            <% resumenMaterialesMes.forEach(r => { %>
              <div class="border rounded-3 p-2 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0 text-success">
                    <i class="bi bi-calendar-event me-1"></i> <%= r.label %>
                  </h6>
                  <span class="badge bg-success">
                    Total: <%= r.totalProductos %> productos
                  </span>
                </div>

                <% if (Array.isArray(r.materialesDetallados) && r.materialesDetallados.length) { %>
                  <div class="table-responsive mt-2">
                    <table class="table table-sm table-bordered align-middle mb-0">
                      <thead class="table-success">
                        <tr>
                          <th>Material</th>
                          <th class="text-end">Cantidad (productos)</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% r.materialesDetallados.forEach(m => { %>
                          <tr>
                            <td><%= m.nombre %></td>
                            <td class="text-end"><%= m.cantidad %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <p class="text-muted small mb-0 mt-2">
                    No hay materiales registrados en este mes.
                  </p>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-muted mb-0">
              Todavía no hay datos suficientes para generar el recuento mensual de materiales.
            </p>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- SERVICIOS DE AMBULANCIA -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-truck-front me-1"></i> Servicios de ambulancia</span>
        <span class="badge bg-light text-success"><%= (servicios || []).length %></span>
      </div>
      <div class="card-body p-2">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th>#</th>
                <th>Folio</th>
                <th>Fecha</th>
                <th>Unidad</th>
                <th>Tipo de servicio</th>
                <th>Lugar</th>
                <% if (isAdmin) { %><th class="text-center">Acciones</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(servicios) && servicios.length) { %>
                <% servicios.forEach((s, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= s.folio %></td>
                    <td><%= s.fecha || '—' %></td>
                    <td><%= s.unidad %></td>
                    <td><%= s.tipo %></td>
                    <td><%= s.lugar || s.ubicacion || '—' %></td>
                    <% if (isAdmin) { %>
                      <td class="text-center">
                        <form action="/servicios/<%= s._id %>/eliminar" method="POST"
                              class="d-inline"
                              onsubmit="return confirm('¿Eliminar este servicio de ambulancia?');">
                          <% if (typeof csrfToken !== 'undefined') { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <button class="btn btn-sm btn-outline-danger rounded-pill">
                            <i class="bi bi-trash"></i> Eliminar
                          </button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= isAdmin ? 7 : 6 %>" class="text-center text-muted">
                    No hay servicios registrados.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <a href="/" class="btn btn-secondary w-100 mt-2">⬅ Menú principal</a>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
