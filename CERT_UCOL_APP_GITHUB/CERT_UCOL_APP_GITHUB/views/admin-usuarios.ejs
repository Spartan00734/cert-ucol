<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Administrar usuarios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="bg-light">
  <div class="container mt-4">

    <!-- 🚨 BLOQUE DE ALERT -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <!-- 🚨 FIN BLOQUE DE ALERT -->

    <h1 class="text-success mb-3 text-center">Administración de usuarios</h1>

    <p class="text-muted">
      Solo los administradores pueden ver y administrar las cuentas de usuario.
      No puedes eliminar tu propia cuenta, pero sí puedes eliminar otros usuarios (incluidos otros administradores).
    </p>

    <div class="card shadow-sm mb-4">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0">
          <i class="bi bi-people me-2"></i>Usuarios registrados
        </h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th style="width:60px;">#</th>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th style="width:120px;">Rol</th>
                <th style="width:150px;" class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (Array.isArray(usuarios) && usuarios.length) { %>
                <% usuarios.forEach((u, idx) => {
                     const esMismo = currentUser && String(currentUser._id) === String(u._id);
                %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= u.nombre %></td>
                    <td><%= u.username %></td>
                    <td><%= u.correo || '—' %></td>
                    <td>
                      <% if (u.role === 'admin') { %>
                        <span class="badge bg-danger">Admin</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Trabajador</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <% if (!esMismo) { %>
                        <form
                          action="/admin/usuarios/<%= u._id %>/eliminar"
                          method="POST"
                          class="d-inline"
                          onsubmit="return confirm('🚨 Se eliminará al usuario &quot;<%= u.username %>&quot;. Esta acción no se puede deshacer. ¿Deseas continuar?');">
                          <% if (typeof csrfToken !== 'undefined') { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <button class="btn btn-sm btn-outline-danger rounded-pill">
                            <i class="bi bi-trash me-1"></i>Eliminar
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small">No puedes eliminar tu propia cuenta</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-muted">
                    No hay usuarios registrados.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <a href="/" class="btn btn-secondary w-100 mb-4">⬅ Volver al menú</a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-cerrar alert en 3.5s
    setTimeout(function () {
      var el = document.querySelector('.alert.alert-dismissible');
      if (!el) return;
      try {
        var alert = bootstrap.Alert.getOrCreateInstance(el);
        alert.close();
      } catch (e) {
        el.classList.remove('show');
        el.addEventListener('transitionend', function () { el.remove(); });
      }
    }, 3500);
  </script>
</body>
</html>
